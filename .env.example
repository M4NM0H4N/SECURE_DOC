# Copy to .env and fill in. NEVER commit .env or any real value.
# This file contains placeholders and local-development defaults only.

NODE_ENV=development
PORT=3000

# --- MongoDB -----------------------------------------------------------------
# LOCAL development: Docker single-node replica set (docker-compose.yml), loopback only.
MONGODB_URI=mongodb://localhost:27017/secure_doc_workflow?replicaSet=rs0&directConnection=true
# TESTS: a separate database. Tests refuse to run unless this is a LOCAL MongoDB, because
# they create and drop the database. Never point it at Atlas.
MONGODB_URI_TEST=mongodb://localhost:27017/secure_doc_workflow_test?replicaSet=rs0&directConnection=true
# PRODUCTION (Render): set MONGODB_URI in the Render dashboard to your MongoDB Atlas
# connection string (mongodb+srv://...). Never put it in this file or in git.
# Optional, local only: put the Atlas string here to run "npm run check:atlas".
# MONGODB_ATLAS_URI=

# --- Auth --------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app refuses to start with this placeholder (shorter than the required 32 characters).
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=2h
COOKIE_NAME=sdw_token

# --- Institutions (SaaS S1) -----------------------------------------------------
# SIGNUP_KEY opens institution signup (POST /api/platform/signup). Leave it unset to keep
# signup closed. 16+ characters; share it only with institutions you invite.
# SIGNUP_KEY=
# One-time platform owner seed (npm run seed:superadmin). Remove the password afterwards.
# SUPER_ADMIN_EMAIL=owner@example.com
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=Platform Owner

# --- Accounts (SaaS S3). See docs/ACCOUNTS.md ----------------------------------
# PUBLIC_URL: https origin used in invite/reset links (required in production, never taken
# from the request). Defaults to http://localhost:<PORT> in development.
# PUBLIC_URL=https://docflow.example.com
# MFA_ENCRYPTION_KEY: 32+ characters; enables two-step sign-in. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"   (never reuse JWT_SECRET)
# MFA_ENCRYPTION_KEY=
# REQUIRE_EMAIL_VERIFICATION=true makes unverified students unable to submit (needs working e-mail, S5).
# REQUIRE_EMAIL_VERIFICATION=false

# --- Document storage, scanning and verification (SaaS S4). See docs/TRUST.md ----
# STORAGE_DRIVER=local (default) keeps files under UPLOAD_DIR. s3 uses a PRIVATE S3-compatible
# bucket (Cloudflare R2 recommended). Use a token limited to this one bucket.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# SCAN_MODE: off (default in development) | optional | required (default in production).
# Anything but off needs a ClamAV daemon (CLAMD_HOST). In production the app will not start
# without CLAMD_HOST unless you set SCAN_MODE=off on purpose.
# SCAN_MODE=off
# CLAMD_HOST=
# CLAMD_PORT=3310
# Replaced/revoked files are kept this many days before 'npm run storage:cleanup' may delete them.
# DOCUMENT_RETENTION_DAYS=30
# Signs document verification (QR) codes; 32+ characters, never reuse JWT_SECRET.
# VERIFY_SIGNING_KEY=

# --- E-mail and notifications (SaaS S5). See docs/NOTIFICATIONS.md ---------------
# MAIL_PROVIDER: outbox (in memory, development/tests only), resend, or none (production default).
# MAIL_PROVIDER=resend
# MAIL_FROM=DocFlow <no-reply@example.com>
# RESEND_API_KEY=
# RESEND_API_URL=https://api.resend.com
# Run the notification worker inside the web process (small deployments). Otherwise: npm run worker
# WORKER_INLINE=false

# --- File storage (outside client/, never served statically) -------------------
# Production on Render: use a persistent disk path (for example /var/data/uploads),
# otherwise uploaded documents are lost on every deploy/restart. See docs/DEPLOYMENT.md.
UPLOAD_DIR=server/uploads
MAX_UPLOAD_MB=5

# --- Network (optional) ------------------------------------------------------
# HOST: defaults to all IPv4 interfaces (0.0.0.0) in production, Node default in development.
# TRUST_PROXY: reverse-proxy hops to trust for the client IP. Defaults to 1 in production
# (Render), 0 in development. Whole numbers only.
# HOST=0.0.0.0
# TRUST_PROXY=1

# --- Demo data (npm run seed:demo). Local/demo use only; refused in production. ----
# DEMO_PASSWORD=choose_a_demo_password_with_a_number1

# --- S7 integrations ----------------------------------------------------------------
# WEBHOOK_ENCRYPTION_KEY=   # 32+ random characters; REQUIRED in production (encrypts webhook secrets)
# API_RATE_LIMIT_MAX=120    # requests per minute per API key
